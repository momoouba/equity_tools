# 本地 we-mp-rss
MP_RSS_HOST_BIND=127.0.0.1
MP_RSS_HOST_PORT=8001
MP_RSS_USERNAME=admin
MP_RSS_PASSWORD=admin@123
# 国内拉不动 ghcr 时可换：
# MP_RSS_IMAGE=docker.1ms.run/rachelos/we-mp-rss:latest
# 或 docker hub：rachelos/we-mp-rss:latest
MP_RSS_IMAGE=ghcr.io/rachelos/we-mp-rss:latest

GATHER_MODEL=weread_mp
GATHER_CONTENT=True
RSS_FULL_CONTEXT=True
WEREAD_CONTENT_INTERVAL=2

# 可选：从浏览器 weread.qq.com 复制 Cookie（含 wr_vid / wr_skey / wr_rt）
# WEREAD_COOKIE=wr_vid=...; wr_skey=...; wr_rt=...
