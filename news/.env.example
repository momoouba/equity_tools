# 复制为 .env 后按需修改（.env 已加入 .gitignore，勿提交真实密码）
# Docker Compose 部署时：与 docker-compose.yml 中 mysql / app 的环境变量对齐

# ========== 应用端口（本地开发若 3001 被占用可改为 3002 等；PORT 与 VITE_DEV_API_PORT 须一致）==========
# PORT=3001
# VITE_DEV_API_PORT=3001

# ========== 数据库（Docker 内 app 连 mysql 服务名，勿写 localhost）==========
DB_HOST=mysql
DB_PORT=3306
DB_NAME=investment_tools
DB_USER=news_app
DB_PASSWORD=请替换为强密码

# 供 docker-compose 中 mysql 服务初始化（与 DB_* 保持一致或按需单独设 root）
MYSQL_ROOT_PASSWORD=请替换为强密码
# 宿主机映射端口，默认 3307，避免与本机 3306 冲突
# MYSQL_PORT=3307

# ========== 竞品分析 S4 联网（可选）==========
# 524 来自 Cloudflare 读超时（默认 120s）。background 模式下 POST 只等入队，长检索走 poll。
# COMPETITOR_WEB_TIMEOUT_MS=180000          # 单次联网总预算（poll 上限参考）
# COMPETITOR_WEB_RETRIES=2                  # 联网失败重试次数（524 建议 2，避免过长）
# COMPETITOR_WEB_524_BACKOFF_MS=120000      # 遇 524 后等待再重试（与 CF retry_after 对齐）
# COMPETITOR_WEB_NO_SEARCH_TIMEOUT_MS=300000 # 降级无联网时的超时
# COMPETITOR_WEB_FORCE_NO_SEARCH=0        # 1=强制跳过联网
# LLM_GATEWAY_ASYNC_RESPONSES=1           # 网关 Responses 后台任务（默认开）
# LLM_RESPONSES_SUBMIT_TIMEOUT_MS=45000     # background POST 入队超时（应远小于 120s）
# LLM_RESPONSES_POLL_MAX_MS=900000        # 后台 poll 最长等待（可 15min+）
# LLM_RESPONSES_POLL_INTERVAL_MS=5000       # poll 间隔

# ========== Playwright（本地 Windows / 生产 Linux 共用）==========
# 本地：不要设置 PLAYWRIGHT_BROWSERS_PATH（或确保目录真实存在）；执行 python -m playwright install chromium
# Docker：compose 已设置 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright，勿复制到本机 .env
#
# 百度百科浏览器抓取：
#   headless = 容器/本机 Playwright Chromium（生产默认；易被 BIOC 软拦截）
#   cdp      = 连接宿主机/本机真实 Chrome（推荐生产兜底）
# BAIKE_BROWSER_MODE=headless
# BAIKE_CDP_URL=http://127.0.0.1:9222
# Docker 连宿主机 Chrome：先 ./server/scripts/startChromeForBaike.sh，再：
# BAIKE_BROWSER_MODE=cdp
# BAIKE_CDP_URL=http://host.docker.internal:9222
# BAIKE_BROWSER_BATCH=20
#
# 境外备案 / 辅导备案可选：仅当需指定本机 Chromium 可执行文件时设置（勿填容器内 linux 路径）
# OVERSEAS_FILING_PLAYWRIGHT_EXECUTABLE=
# CSRC_GUIDANCE_PLAYWRIGHT_EXECUTABLE=
# 境外备案 Excel：手动指定 Referer（一般无需设；自动发现时由 Node 传入详情页 OVERSEAS_FILING_DETAIL_PAGE_URL）
# OVERSEAS_FILING_EXCEL_REFERER=
# HTTP 仍返回 HTML 时会用 Playwright 拉 xlsx；若需禁用：OVERSEAS_FILING_DISABLE_PLAYWRIGHT_XLSX=1
#
# ========== 上市进展：辅导备案 / 境外备案（可选）==========
# 本地开发可用 Windows 路径；Docker 内请改为容器内路径或挂载路径
# CSRC_GUIDANCE_CSV_PATH=/app/server/utils/listing/mock-guidance.csv
# OVERSEAS_FILING_FILE_PATH=/app/server/utils/listing/mock-overseas.csv
# CSRC_GUIDANCE_SOURCE=html
# OVERSEAS_FILING_SOURCE=url
# 境外备案 Excel：默认证监会信息公开「境外证券发行」栏目（与程序内 DEFAULT 一致）；覆盖默认时设置
# CSRC_ZFXXGK_PAGE_URL=http://www.csrc.gov.cn/csrc/c101935/zfxxgk_zdgk.shtml?channelid=8f3f0d4be56b4f8aa8183b3234b88ede
# 境外备案：备案通知书列表（政府信息公开·境外证券发行）；默认与 CSRC 栏目一致，一般无需配置
# OVERSEAS_FILING_NOTICE_LIST_URL=http://www.csrc.gov.cn/csrc/c101935/zfxxgk_zdgk.shtml?channelid=8f3f0d4be56b4f8aa8183b3234b88ede
# 仅跑 Excel 链路、暂不抓通知书 HTML 时设为 1
# OVERSEAS_FILING_NOTICE_DISABLE=1
# 上市进展定时：数据入库失败后当日自动重试（默认 60 分钟后重试、每天最多 2 次；设为 0 关闭自动重试）
# LISTING_SYNC_RETRY_DELAY_MIN=60
# LISTING_SYNC_RETRY_MAX=2
# 境外备案 Excel 为「截至发布日」累计快照表：抓取窗口起点默认前移 14 天，避免漏掉接收日期早于发布日的新增行（0=不前移）
# OVERSEAS_FILING_WINDOW_LOOKBACK_DAYS=14
# 境外备案定时任务全量快照比对的回看天数上限（默认 90；与 minSyncDate 取较晚者）
# OVERSEAS_FILING_SNAPSHOT_LOOKBACK_DAYS=90

# ========== wewe-rss 私有公众号专队 ==========
# 本地 npm run dev：wewe 另起 deploy/wewe-rss，填 127.0.0.1:4000
# Docker 生产（主 compose 已含 wewe-rss 服务）：用服务名，勿写 localhost
# WEWE_RSS_BASE_URL=http://wewe-rss:4000
# WEWE_RSS_AUTH_CODE=请换成强随机串（与 wewe 容器 AUTH_CODE 同一值）
# WEWE_HOST_PORT=4000
# WEWE_HOST_BIND=127.0.0.1
# WEWE_SERVER_ORIGIN_URL=https://你的新闻域名或 http://公网IP:4000
# WEWE_PLATFORM_URL=https://weread.111965.xyz
# 活码邮件外链（须公网可打开新闻站点）
# NEWS_PUBLIC_BASE_URL=https://你的新闻域名
# WEWE_LIVE_QR_SECRET=请换成随机长串
# WEWE_LIVE_QR_TTL_HOURS=48
# WEWE_OPS_EMAIL=ops@example.com
# wewe-rss Node 堆（默认 4096MB，避免 feed 全量时 ~2GB OOM）；改完需 recreate wewe-rss，data 卷会保留会话
# WEWE_NODE_OPTIONS=--max-old-space-size=4096
#
# 上线分步：容器起来后先在管理页扫码；专队开关默认关，确认会话可用再开 enqueue → extract/ingest

# ========== 代理配置（用于访问被墙/限流的网站）==========
# 将 <Mac局域网IP> 替换为你的 Mac 实际 IP（如 192.168.1.100）
# 将 <代理端口> 替换为代理软件端口（Clash 默认 7890）
# HTTP_PROXY=http://<Mac局域网IP>:<代理端口>
# HTTPS_PROXY=http://<Mac局域网IP>:<代理端口>
# ALL_PROXY=http://<Mac局域网IP>:<代理端口>
# NO_PROXY=localhost,127.0.0.1,mysql
