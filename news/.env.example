# 复制为 .env 后按需修改（.env 已加入 .gitignore，勿提交真实密码）
# Docker Compose 部署时：与 docker-compose.yml 中 mysql / app 的环境变量对齐

# ========== 应用端口（本地开发若 3001 被占用可改为 3002 等；PORT 与 VITE_DEV_API_PORT 须一致）==========
# PORT=3001
# VITE_DEV_API_PORT=3001

# ========== 数据库（Docker 内 app 连 mysql 服务名，勿写 localhost）==========
DB_HOST=mysql
DB_PORT=3306
DB_NAME=investment_tools
DB_USER=news_app
DB_PASSWORD=请替换为强密码

# 供 docker-compose 中 mysql 服务初始化（与 DB_* 保持一致或按需单独设 root）
MYSQL_ROOT_PASSWORD=请替换为强密码
# 宿主机映射端口，默认 3307，避免与本机 3306 冲突
# MYSQL_PORT=3307

# ========== Playwright（本地 Windows / 生产 Linux 共用）==========
# 本地：不要设置 PLAYWRIGHT_BROWSERS_PATH（或确保目录真实存在）；执行 python -m playwright install chromium
# Docker：compose 已设置 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright，勿复制到本机 .env
#
# 境外备案 / 辅导备案可选：仅当需指定本机 Chromium 可执行文件时设置（勿填容器内 linux 路径）
# OVERSEAS_FILING_PLAYWRIGHT_EXECUTABLE=
# CSRC_GUIDANCE_PLAYWRIGHT_EXECUTABLE=
# 境外备案 Excel：手动指定 Referer（一般无需设；自动发现时由 Node 传入详情页 OVERSEAS_FILING_DETAIL_PAGE_URL）
# OVERSEAS_FILING_EXCEL_REFERER=
# HTTP 仍返回 HTML 时会用 Playwright 拉 xlsx；若需禁用：OVERSEAS_FILING_DISABLE_PLAYWRIGHT_XLSX=1
#
# ========== 上市进展：辅导备案 / 境外备案（可选）==========
# 本地开发可用 Windows 路径；Docker 内请改为容器内路径或挂载路径
# CSRC_GUIDANCE_CSV_PATH=/app/server/utils/上市进展/mock-guidance.csv
# OVERSEAS_FILING_FILE_PATH=/app/server/utils/上市进展/mock-overseas.csv
# CSRC_GUIDANCE_SOURCE=html
# OVERSEAS_FILING_SOURCE=url

# ========== 代理配置（用于访问被墙/限流的网站）==========
# 将 <Mac局域网IP> 替换为你的 Mac 实际 IP（如 192.168.1.100）
# 将 <代理端口> 替换为代理软件端口（Clash 默认 7890）
# HTTP_PROXY=http://<Mac局域网IP>:<代理端口>
# HTTPS_PROXY=http://<Mac局域网IP>:<代理端口>
# ALL_PROXY=http://<Mac局域网IP>:<代理端口>
# NO_PROXY=localhost,127.0.0.1,mysql
