{
  "name": "news-sentiment-management-system",
  "version": "1.0.0",
  "description": "新闻舆情管理和分析系统",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon --exec \"node --disable-warning=DEP0169\" server/index.js",
    "start": "node --disable-warning=DEP0169 server/index.js",
    "client": "cd client && npm run dev",
    "install-all": "npm install && cd client && npm install",
    "backfill:financing-enrich": "node --disable-warning=DEP0169 server/scripts/backfillFinancingRuleEnrich.js"
  },
  "keywords": [
    "news",
    "sentiment",
    "management",
    "ai-analysis",
    "investment",
    "enterprise-management"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "cron-parser": "^5.5.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.5",
    "iconv-lite": "^0.7.2",
    "multer": "^2.0.2",
    "mysql2": "^3.9.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "pg": "^8.11.3",
    "sharp": "^0.33.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.10.23",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  }
}
